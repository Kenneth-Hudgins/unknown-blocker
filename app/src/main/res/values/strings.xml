    <string name="probe_logging_label">Write diagnostic log file</string>
    <string name="probe_help">Off by default. When on, writes listener events (full timestamps) to a text file — useful if VM mute misbehaves. Auto-deletes at 2 MB. Open in a browser or text app.</string>
